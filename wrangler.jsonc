{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "knoxified-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://elpljgrwrzaugsunoidf.supabase.co",
    "NEXT_PUBLIC_VOICE_AGENT_URL": "https://voice-agent-beta.roofing-dashboard.workers.dev",
    "NEXT_PUBLIC_VOICE_AGENT_NUMBER": "+15302030545",
    "SUPABASE_URL": "https://elpljgrwrzaugsunoidf.supabase.co"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "knoxified-dashboard"
    },
    {
      "binding": "VOICE_AGENTS",
      "service": "voice-agent-beta"
    },
    {
      "binding": "OAUTH",
      "service": "knoxified-auth"
    }
  ]
}

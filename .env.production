# These are NEXT_PUBLIC_* values, which Next.js explicitly documents as
# public/embeddable in client-side code -- not secrets. They're committed
# here (rather than relying only on Cloudflare's "Runtime Variables" panel)
# because NEXT_PUBLIC_ vars must be present in the environment at BUILD
# TIME to be inlined into the client bundle -- a "runtime" variable added
# after the fact doesn't retroactively fix an already-built deployment,
# and it was unclear whether Cloudflare's Runtime Variables panel feeds
# into the Next.js build step at all for this project. Committing this
# file removes that ambiguity entirely: Next.js reads .env.production
# automatically during `next build`, regardless of platform-specific
# variable-scoping behavior.
#
# The real secrets (SUPABASE_SERVICE_ROLE_KEY, etc. -- anything WITHOUT
# the NEXT_PUBLIC_ prefix) must NOT go in this file. Those stay in
# Cloudflare's Runtime Variables as Secrets, same as before.

NEXT_PUBLIC_SUPABASE_URL=https://elpljgrwrzaugsunoidf.supabase.co
